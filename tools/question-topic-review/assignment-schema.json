{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_start",
    "batch_end",
    "source_sha256",
    "taxonomy_sha256",
    "input_sha256",
    "assignments"
  ],
  "properties": {
    "batch_start": { "type": "integer", "minimum": 0 },
    "batch_end": { "type": "integer", "minimum": 0 },
    "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "taxonomy_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row_index", "topic_id", "confidence", "alternate_topic_id", "note"],
        "properties": {
          "row_index": { "type": "integer", "minimum": 0 },
          "topic_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "alternate_topic_id": {
            "type": ["string", "null"],
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
